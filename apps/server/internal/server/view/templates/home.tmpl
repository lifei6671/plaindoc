<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if .Title }}{{ .Title }} - {{ end }}PlainDoc - 一个适合中小团队文档在线管理系统</title>
  <meta name="description" content="{{ .Description }}">
  <link rel="canonical" href="{{ .CanonicalURL }}">
  <link rel="icon" type="image/png" href="/assets/favicon-ico.png">
  <link rel="apple-touch-icon" href="/assets/favicon-ico.png">
  <link rel="preload" href="/assets/google-sans-code-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/font-google-sans-code.css?v=20260224">
  <link rel="stylesheet" href="/assets/home-youtube.css?v=20260225">
</head>
<body class="yt-home-body">
  {{ template "youtube_top_nav" . }}
  <div class="yt-shell">
    {{ template "youtube_sidebar" . }}

    <main class="yt-main">
      <div class="yt-main-content">
        <header class="yt-page-header">
          <p class="yt-page-kicker">For You</p>
          <h1 class="yt-page-title">推荐空间流</h1>
          <p class="yt-page-subtitle">快速浏览你可访问的文档空间。</p>
        </header>

        {{ template "youtube_category_chips" . }}

        <section class="yt-grid" aria-label="首页空间列表">
          {{ if .Spaces }}
            {{ range .Spaces }}
              {{ template "youtube_space_card" . }}
            {{ end }}
          {{ else }}
            <div class="yt-empty">当前暂无可见空间</div>
          {{ end }}
        </section>
      </div>

      {{ template "youtube_footer" . }}
    </main>
  </div>
  <script src="/assets/home.js?v=20260224" defer></script>
</body>
</html>
