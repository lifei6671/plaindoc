# =========================
# 基础运行配置
# =========================

# APP_ENV: 运行环境。
# 可选值: development / test / production。
# 说明: 生产环境会启用更严格配置校验（例如要求显式设置 JWT_SECRET）。
APP_ENV=development

# APP_ADDR: HTTP 服务监听地址。
# 示例:
#   :8080            -> 监听本机所有网卡的 8080 端口
#   127.0.0.1:8080   -> 仅本机回环地址可访问
APP_ADDR=:8080

# WEB_ORIGIN: 允许跨域访问后端的前端来源（CORS Access-Control-Allow-Origin）。
# 开发环境通常是 Vite 地址，生产环境应替换为真实前端域名。
WEB_ORIGIN=http://localhost:5173

# WEB_DIST_DIR: 前端 Web 构建产物目录（index.html 所在目录）。
# 生产部署时由 Go 直接托管该目录下的 SPA 资源（/login、/editor、/admin 等）。
# 示例:
#   apps/web/dist
#   /app/apps/web/dist
WEB_DIST_DIR=apps/web/dist

# LOG_LEVEL: 日志级别（结构化日志）。
# 可选值: debug / info / warn / error。
LOG_LEVEL=info

# LOG_OUTPUT: 日志输出位置。
# 可选值:
# - stdout: 仅输出到控制台
# - file:   仅输出到日志文件
# - both:   同时输出到控制台和日志文件
LOG_OUTPUT=stdout

# LOG_FILE_PATH: 日志文件路径（当 LOG_OUTPUT=file 或 both 时必填）。
# 示例: /var/log/plaindoc/server.log 或 ./logs/server.log
LOG_FILE_PATH=


# =========================
# 请求与 HTTP 超时配置
# =========================

# REQUEST_TIMEOUT: 单个请求的业务超时时间。
# 格式: Go duration（如 500ms, 10s, 2m）。
# 说明: 超时后会返回统一错误码 REQUEST_TIMEOUT（HTTP 504）；SSE 长连接会跳过该业务超时。
REQUEST_TIMEOUT=10s

# HTTP_READ_TIMEOUT: 读取完整请求（含请求头和请求体）的最大时长。
HTTP_READ_TIMEOUT=15s

# HTTP_WRITE_TIMEOUT: 写回响应的最大时长。
# 说明: SSE 长连接会在 handler 内清除写截止时间，避免流式响应被固定写超时切断。
HTTP_WRITE_TIMEOUT=15s

# HTTP_IDLE_TIMEOUT: Keep-Alive 空闲连接的最大保留时长。
HTTP_IDLE_TIMEOUT=60s


# =========================
# 数据库连接配置（Milestone 2 会正式接入）
# =========================

# DB_DRIVER: 数据库驱动类型。
# 可选值: sqlite / postgres / mysql。
DB_DRIVER=sqlite

# DB_AUTO_MIGRATE: 服务启动时是否自动执行数据库迁移。
# 可选值: true / false。
DB_AUTO_MIGRATE=true

# GORM_LOG_SQL: 是否输出 GORM SQL 执行日志。
# 可选值: true / false。
# 默认建议保持 false，排查数据库问题时再显式开启。
GORM_LOG_SQL=false

# DB_DSN: 数据库连接串（Data Source Name）。
# 当前默认值为 SQLite 本地文件。
# SQLite 示例:
#   file:plaindoc.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# PostgreSQL 示例:
#   postgres://user:password@127.0.0.1:5432/plaindoc?sslmode=disable
# MySQL 示例:
#   user:password@tcp(127.0.0.1:3306)/plaindoc?parseTime=true&loc=Local
DB_DSN='file:plaindoc.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)'

# SEARCH_BLEVE_DIR: 内置 Bleve 索引目录（可选）。
# 为空时默认使用 `data/search/bleve`。
# 示例:
#   ./data/search/bleve
#   /app/data/search/bleve
SEARCH_BLEVE_DIR=


# =========================
# JWT 鉴权配置（Milestone 3 会正式接入）
# =========================

# JWT_SECRET: JWT 签名密钥。
# 要求:
# - 生产环境必须替换为高强度随机字符串（至少 32 字符）。
# - 不要提交真实生产密钥到仓库。
JWT_SECRET=plaindoc-dev-secret

# JWT_ACCESS_TOKEN_TTL: Access Token 有效期。
# 建议: 10m~30m 之间，缩短泄露风险窗口。
JWT_ACCESS_TOKEN_TTL=15m

# JWT_REFRESH_TOKEN_TTL: Refresh Token 有效期。
# 建议: 7d~30d，根据安全策略调整。
JWT_REFRESH_TOKEN_TTL=168h


# =========================
# SSR 子进程（Go 管理 Node Worker）
# =========================

# SSR_WORKER_ENABLED: 是否启用 Go 拉起的 Node SSR 子进程。
# 可选值: true / false。
SSR_WORKER_ENABLED=false

# SSR_WORKER_EXEC: Node 可执行命令。
# 示例:
#   node
#   /usr/local/bin/node
SSR_WORKER_EXEC=node

# SSR_WORKER_ENTRY: SSR Worker 入口脚本路径（构建产物）。
# 建议填写绝对路径；若为相对路径，则相对于服务启动工作目录解析。
# 示例: ./apps/web/dist-ssr/worker-entry.js
SSR_WORKER_ENTRY=

# SSR_WORKER_COUNT: 常驻 Worker 进程数。
SSR_WORKER_COUNT=2

# SSR_RENDER_TIMEOUT: 单次渲染请求超时时间。
SSR_RENDER_TIMEOUT=1500ms

# SSR_WORKER_START_TIMEOUT: Worker 启动握手超时时间。
SSR_WORKER_START_TIMEOUT=5s

# SSR_WORKER_MAX_PAYLOAD_BYTES: Go 发送给 Worker 的单次请求 payload 上限；支持纯字节数或 KB/MB/GB、KiB/MiB/GiB（按 1024 进制）。
SSR_WORKER_MAX_PAYLOAD_BYTES=1MB

# SSR_WORKER_MAX_RESPONSE_BYTES: Worker 返回给 Go 的单次响应 payload 上限；支持纯字节数或 KB/MB/GB、KiB/MiB/GiB（按 1024 进制）。
SSR_WORKER_MAX_RESPONSE_BYTES=16MB

# SSR_PROTOCOL_VERSION: Go 与 Worker 的协议版本标识。
SSR_PROTOCOL_VERSION=v1
