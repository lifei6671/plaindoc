# =========================
# 基础运行配置
# =========================

# APP_ENV: 运行环境。
# 可选值: development / test / production。
# 说明: 生产环境会启用更严格配置校验（例如要求显式设置 JWT_SECRET）。
APP_ENV=development

# APP_ADDR: HTTP 服务监听地址。
# 示例:
#   :8080            -> 监听本机所有网卡的 8080 端口
#   127.0.0.1:8080   -> 仅本机回环地址可访问
APP_ADDR=:8080

# WEB_ORIGIN: 允许跨域访问后端的前端来源（CORS Access-Control-Allow-Origin）。
# 开发环境通常是 Vite 地址，生产环境应替换为真实前端域名。
WEB_ORIGIN=http://localhost:5173

# LOG_LEVEL: 日志级别（结构化日志）。
# 可选值: debug / info / warn / error。
LOG_LEVEL=info

# LOG_OUTPUT: 日志输出位置。
# 可选值:
# - stdout: 仅输出到控制台
# - file:   仅输出到日志文件
# - both:   同时输出到控制台和日志文件
LOG_OUTPUT=stdout

# LOG_FILE_PATH: 日志文件路径（当 LOG_OUTPUT=file 或 both 时必填）。
# 示例: /var/log/plaindoc/server.log 或 ./logs/server.log
LOG_FILE_PATH=


# =========================
# 请求与 HTTP 超时配置
# =========================

# REQUEST_TIMEOUT: 单个请求的业务超时时间。
# 格式: Go duration（如 500ms, 10s, 2m）。
# 说明: 超时后会返回统一错误码 REQUEST_TIMEOUT（HTTP 504）。
REQUEST_TIMEOUT=10s

# HTTP_READ_TIMEOUT: 读取完整请求（含请求头和请求体）的最大时长。
HTTP_READ_TIMEOUT=15s

# HTTP_WRITE_TIMEOUT: 写回响应的最大时长。
HTTP_WRITE_TIMEOUT=15s

# HTTP_IDLE_TIMEOUT: Keep-Alive 空闲连接的最大保留时长。
HTTP_IDLE_TIMEOUT=60s


# =========================
# 数据库连接配置（Milestone 2 会正式接入）
# =========================

# DB_DRIVER: 数据库驱动类型。
# 可选值: sqlite / postgres / mysql。
DB_DRIVER=sqlite

# DB_AUTO_MIGRATE: 服务启动时是否自动执行数据库迁移。
# 可选值: true / false。
DB_AUTO_MIGRATE=true

# DB_DSN: 数据库连接串（Data Source Name）。
# 当前默认值为 SQLite 本地文件。
# SQLite 示例:
#   file:plaindoc.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# PostgreSQL 示例:
#   postgres://user:password@127.0.0.1:5432/plaindoc?sslmode=disable
# MySQL 示例:
#   user:password@tcp(127.0.0.1:3306)/plaindoc?parseTime=true&loc=Local
DB_DSN=file:plaindoc.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)


# =========================
# JWT 鉴权配置（Milestone 3 会正式接入）
# =========================

# JWT_SECRET: JWT 签名密钥。
# 要求:
# - 生产环境必须替换为高强度随机字符串（至少 32 字符）。
# - 不要提交真实生产密钥到仓库。
JWT_SECRET=plaindoc-dev-secret

# JWT_ACCESS_TOKEN_TTL: Access Token 有效期。
# 建议: 10m~30m 之间，缩短泄露风险窗口。
JWT_ACCESS_TOKEN_TTL=15m

# JWT_REFRESH_TOKEN_TTL: Refresh Token 有效期。
# 建议: 7d~30d，根据安全策略调整。
JWT_REFRESH_TOKEN_TTL=168h
