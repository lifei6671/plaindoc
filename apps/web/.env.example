# =========================
# PlainDoc Web 环境变量示例
# =========================
#
# 使用方式：
# 1) 复制本文件为 `.env.local`（推荐），按需修改。
# 2) 启动命令：`npm run dev -w @plaindoc/web`。
# 3) 修改环境变量后需重启 dev server，Vite 不会对 .env 热更新。
#
# 变量优先级（高 -> 低）：
# - `.env.local`
# - `.env`
# - `.env.[mode]` / `.env.[mode].local`
#
# 注意：
# - 前端仅会暴露以 `VITE_` 开头的变量给浏览器端代码。
# - 请勿在前端环境变量中放置密钥（会被打包到客户端）。

# VITE_DATA_DRIVER:
# 前端数据驱动类型（见 `apps/web/src/data-access/index.ts`）。
# 可选值：
# - local: 使用本地 IndexedDB 适配器（默认，离线开发推荐）
# - http:  使用后端 HTTP 适配器（联调/集成测试推荐）
#
# 说明：
# - 当前代码只识别 `http`，其他任意值都会回退为 `local`。
VITE_DATA_DRIVER=http

# VITE_API_BASE_URL:
# 当 `VITE_DATA_DRIVER=http` 时，前端请求的 API 基础地址。
#
# 常见写法：
# 1) 相对地址（推荐，开发阶段前后端统一端口）：
#    VITE_API_BASE_URL=/api
# 2) 绝对地址（不走 Vite 反代）：
#    VITE_API_BASE_URL=http://localhost:8080/api
#
# 开发推荐：
# - 配合 `vite.config.ts` 中 `/api -> VITE_DEV_PROXY_TARGET` 反向代理；
# - 浏览器统一访问 `http://localhost:3001`，避免前后端跨端口调试复杂度。
VITE_API_BASE_URL=/api

# VITE_DEV_PROXY_TARGET:
# 仅开发环境生效：Vite `server.proxy` 的后端目标地址。
# 默认值: http://localhost:8080
# 说明:
# - 当前默认会把 `/api/*` 代理到 `${VITE_DEV_PROXY_TARGET}/api/*`。
# - 除了 Web 路由（`/login` `/register` `/editor/*` `/admin/*`）外，
#   其他 URL 也会统一代理到后端（用于 Go SSR 页面与静态资源）。
# - 生产环境不使用此变量（由部署网关或反向代理接管）。
VITE_DEV_PROXY_TARGET=http://localhost:8080
