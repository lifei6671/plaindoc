# =========================
# PlainDoc Web 环境变量示例
# =========================
#
# 使用方式：
# 1) 复制本文件为 `.env.local`（推荐），按需修改。
# 2) 启动命令：`npm run dev -w @plaindoc/web`。
# 3) 修改环境变量后需重启 dev server，Vite 不会对 .env 热更新。
#
# 变量优先级（高 -> 低）：
# - `.env.local`
# - `.env`
# - `.env.[mode]` / `.env.[mode].local`
#
# 注意：
# - 前端仅会暴露以 `VITE_` 开头的变量给浏览器端代码。
# - 请勿在前端环境变量中放置密钥（会被打包到客户端）。

# VITE_DATA_DRIVER:
# 前端数据驱动类型（见 `apps/web/src/data-access/index.ts`）。
# 可选值：
# - local: 使用本地 IndexedDB 适配器（默认，离线开发推荐）
# - http:  使用后端 HTTP 适配器（联调/集成测试推荐）
#
# 说明：
# - 当前代码只识别 `http`，其他任意值都会回退为 `local`。
VITE_DATA_DRIVER=local

# VITE_API_BASE_URL:
# 当 `VITE_DATA_DRIVER=http` 时，前端请求的 API 基础地址。
#
# 常见写法：
# 1) 绝对地址（推荐，最直观）：
#    VITE_API_BASE_URL=http://localhost:8080/api
# 2) 相对地址（需在 Vite 配置 server.proxy）：
#    VITE_API_BASE_URL=/api
#
# 若使用相对地址但未配置 proxy，开发环境会请求到前端服务自身端口（默认 3001）。
VITE_API_BASE_URL=/api
